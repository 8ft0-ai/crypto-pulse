#!/bin/sh
set -eu

case "$0" in
  */*) SCRIPT_DIR=$(CDPATH= cd -- "${0%/*}" && pwd -P) ;;
  *) echo "cp: launcher must be invoked by path" >&2; exit 4 ;;
esac
ROOT_DIR=$(CDPATH= cd -- "$SCRIPT_DIR/../.." && pwd -P)

PYTHON_CANDIDATES="/opt/homebrew/bin/python3 /usr/local/bin/python3 /usr/bin/python3 /Library/Frameworks/Python.framework/Versions/Current/bin/python3"
GIT_CANDIDATES="/usr/bin/git /opt/homebrew/bin/git /usr/local/bin/git"

PYTHON=""
for candidate in $PYTHON_CANDIDATES; do
  if [ -x "$candidate" ] && "$candidate" -I -c 'import sys; raise SystemExit(0 if sys.version_info >= (3, 12) else 1)' >/dev/null 2>&1; then
    PYTHON=$candidate
    break
  fi
done
if [ -z "$PYTHON" ]; then
  echo "cp: python3 >= 3.12 is required at an approved system path" >&2
  exit 4
fi

GIT=""
for candidate in $GIT_CANDIDATES; do
  if [ -x "$candidate" ]; then
    GIT=$candidate
    break
  fi
done
if [ -z "$GIT" ]; then
  echo "cp: git is required at an approved system path" >&2
  exit 4
fi

RUNTIME_PATHS="tools/operator/cp tools/operator/operator.toml tools/operator/cryptopulse_operator"
TOP=$("$GIT" -C "$ROOT_DIR" rev-parse --show-toplevel 2>/dev/null || true)
if [ "$TOP" != "$ROOT_DIR" ]; then
  echo "cp: trusted runtime root is not the repository toplevel" >&2
  exit 4
fi
if ! "$GIT" -C "$ROOT_DIR" diff-index --cached --quiet HEAD -- $RUNTIME_PATHS; then
  echo "cp: trusted runtime index differs from HEAD" >&2
  exit 4
fi
if ! "$GIT" -C "$ROOT_DIR" diff-files --quiet -- $RUNTIME_PATHS; then
  echo "cp: trusted runtime files differ from HEAD" >&2
  exit 4
fi
if ! UNTRACKED=$("$GIT" -C "$ROOT_DIR" ls-files --others -- tools/operator); then
  echo "cp: unable to inspect untracked runtime files" >&2
  exit 4
fi
if [ -n "$UNTRACKED" ]; then
  echo "cp: trusted runtime contains untracked operator files" >&2
  exit 4
fi
if ! FLAGS=$("$GIT" -C "$ROOT_DIR" ls-files -v -- $RUNTIME_PATHS); then
  echo "cp: unable to inspect trusted runtime index flags" >&2
  exit 4
fi
BAD_FLAGS=0
while IFS= read -r line; do
  case "$line" in
    "H "*) ;;
    *) BAD_FLAGS=1 ;;
  esac
done <<EOF_FLAGS
$FLAGS
EOF_FLAGS
if [ "$BAD_FLAGS" -ne 0 ]; then
  echo "cp: trusted runtime contains hidden index state" >&2
  exit 4
fi

export PYTHONNOUSERSITE=1
export PYTHONDONTWRITEBYTECODE=1
unset PYTHONPATH PYTHONHOME CDPATH ENV BASH_ENV DYLD_INSERT_LIBRARIES DYLD_LIBRARY_PATH LD_PRELOAD LD_LIBRARY_PATH

exec "$PYTHON" -I -c '
import runpy, sys
root = sys.argv[1]
sys.path[:] = [root] + [p for p in sys.path if p and p != "."]
sys.argv = [root + "/cryptopulse_operator/cli.py"] + sys.argv[2:]
runpy.run_module("cryptopulse_operator.cli", run_name="__main__")
' "$SCRIPT_DIR" "$@"
