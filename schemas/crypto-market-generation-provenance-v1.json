{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://8ft0-ai.github.io/crypto-pulse/schemas/crypto-market-generation-provenance-v1.json",
  "title": "CryptoPulse governed LLM generation provenance v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "provider",
    "requested_model",
    "actual_model",
    "actual_provider",
    "prompt_version",
    "analysis_schema_version",
    "evidence_schema_version",
    "source_snapshot",
    "evidence_bundle",
    "generated_at",
    "generation_parameters",
    "usage",
    "generation_id",
    "prompt_sha256",
    "completion_sha256",
    "routing",
    "estimated_cost_usd"
  ],
  "properties": {
    "schema_version": {
      "const": "crypto-market-generation-provenance/v1"
    },
    "provider": {
      "const": "openrouter"
    },
    "requested_model": {"type": "string", "minLength": 1},
    "actual_model": {"type": ["string", "null"], "minLength": 1},
    "actual_provider": {"type": ["string", "null"], "minLength": 1},
    "prompt_version": {"const": "crypto-market-analysis/v1"},
    "analysis_schema_version": {"const": "crypto-market-analysis/v1"},
    "evidence_schema_version": {"const": "crypto-market-evidence-bundle/v1"},
    "source_snapshot": {
      "type": "object",
      "additionalProperties": false,
      "required": ["path", "sha256"],
      "properties": {
        "path": {"type": "string", "minLength": 1},
        "sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"}
      }
    },
    "evidence_bundle": {
      "type": "object",
      "additionalProperties": false,
      "required": ["bundle_id", "sha256"],
      "properties": {
        "bundle_id": {"type": "string", "pattern": "^sha256:[0-9a-f]{64}$"},
        "sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"}
      }
    },
    "generated_at": {"type": "string", "format": "date-time"},
    "generation_parameters": {
      "type": "object",
      "additionalProperties": false,
      "required": ["temperature", "max_output_tokens"],
      "properties": {
        "temperature": {"type": "number", "minimum": 0, "maximum": 2},
        "max_output_tokens": {"type": "integer", "minimum": 1}
      }
    },
    "usage": {
      "type": "object",
      "additionalProperties": false,
      "required": ["input_tokens", "output_tokens", "total_tokens"],
      "properties": {
        "input_tokens": {"type": ["integer", "null"], "minimum": 0},
        "output_tokens": {"type": ["integer", "null"], "minimum": 0},
        "total_tokens": {"type": ["integer", "null"], "minimum": 0}
      }
    },
    "generation_id": {"type": ["string", "null"], "minLength": 1},
    "prompt_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "completion_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "routing": {
      "type": "object",
      "additionalProperties": false,
      "required": ["provider_fallback_used", "cross_model_fallback_used", "provider_preferences"],
      "properties": {
        "provider_fallback_used": {"type": "boolean"},
        "cross_model_fallback_used": {"const": false},
        "provider_preferences": {
          "type": "array",
          "uniqueItems": true,
          "items": {"type": "string", "minLength": 1}
        }
      }
    },
    "estimated_cost_usd": {"type": ["number", "null"], "minimum": 0}
  }
}
