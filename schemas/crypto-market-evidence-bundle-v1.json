{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://8ft0-ai.github.io/crypto-pulse/schemas/crypto-market-evidence-bundle-v1.json",
  "title": "CryptoPulse governed LLM evidence bundle v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "bundle_id",
    "source_snapshot",
    "product_boundaries",
    "evidence"
  ],
  "properties": {
    "schema_version": {
      "const": "crypto-market-evidence-bundle/v1"
    },
    "bundle_id": {
      "type": "string",
      "pattern": "^sha256:[0-9a-f]{64}$"
    },
    "source_snapshot": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "path",
        "sha256",
        "schema_version",
        "quality_status",
        "generated_at_utc"
      ],
      "properties": {
        "path": {
          "type": "string",
          "pattern": "^data/crypto/hourly/.+_source_snapshot\\.json$"
        },
        "sha256": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        },
        "schema_version": {
          "type": "string",
          "minLength": 1
        },
        "quality_status": {
          "enum": [
            "valid-ok",
            "valid-degraded"
          ]
        },
        "generated_at_utc": {
          "type": "string",
          "format": "date-time"
        }
      }
    },
    "product_boundaries": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "evidence": {
      "type": "array",
      "minItems": 1,
      "items": {
        "$ref": "#/$defs/evidence_item"
      }
    }
  },
  "$defs": {
    "subject": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "type",
        "id"
      ],
      "properties": {
        "type": {
          "enum": [
            "asset",
            "market",
            "snapshot",
            "source",
            "exchange_pair",
            "defi_metric"
          ]
        },
        "id": {
          "type": "string",
          "minLength": 1
        },
        "symbol": {
          "type": "string",
          "pattern": "^[A-Za-z0-9._-]+$"
        },
        "name": {
          "type": "string",
          "minLength": 1
        }
      }
    },
    "source_reference": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "name",
        "source_path"
      ],
      "properties": {
        "name": {
          "type": "string",
          "minLength": 1
        },
        "source_path": {
          "type": "string",
          "pattern": "^/"
        }
      }
    },
    "evidence_item": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "evidence_id",
        "evidence_type",
        "subject",
        "field",
        "value",
        "source"
      ],
      "properties": {
        "evidence_id": {
          "type": "string",
          "pattern": "^[a-z][a-z0-9]*(?:[._-][a-z0-9]+)+$"
        },
        "evidence_type": {
          "enum": [
            "number",
            "string",
            "timestamp",
            "status",
            "boolean",
            "set"
          ]
        },
        "subject": {
          "$ref": "#/$defs/subject"
        },
        "field": {
          "type": "string",
          "pattern": "^[a-z][a-z0-9_]*$"
        },
        "value": {
          "oneOf": [
            {
              "type": "number"
            },
            {
              "type": "string"
            },
            {
              "type": "boolean"
            },
            {
              "type": "array",
              "items": {
                "type": [
                  "string",
                  "number",
                  "boolean"
                ]
              }
            }
          ]
        },
        "unit": {
          "type": "string",
          "pattern": "^[a-z][a-z0-9._/-]*$"
        },
        "observed_at": {
          "type": "string",
          "format": "date-time"
        },
        "source": {
          "$ref": "#/$defs/source_reference"
        }
      },
      "allOf": [
        {
          "if": {
            "properties": {
              "evidence_type": {
                "const": "number"
              }
            },
            "required": [
              "evidence_type"
            ]
          },
          "then": {
            "properties": {
              "value": {
                "type": "number"
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "evidence_type": {
                "enum": [
                  "string",
                  "status"
                ]
              }
            },
            "required": [
              "evidence_type"
            ]
          },
          "then": {
            "properties": {
              "value": {
                "type": "string"
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "evidence_type": {
                "const": "timestamp"
              }
            },
            "required": [
              "evidence_type"
            ]
          },
          "then": {
            "properties": {
              "value": {
                "type": "string",
                "format": "date-time"
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "evidence_type": {
                "const": "boolean"
              }
            },
            "required": [
              "evidence_type"
            ]
          },
          "then": {
            "properties": {
              "value": {
                "type": "boolean"
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "evidence_type": {
                "const": "set"
              }
            },
            "required": [
              "evidence_type"
            ]
          },
          "then": {
            "properties": {
              "value": {
                "type": "array",
                "uniqueItems": true
              }
            }
          }
        }
      ]
    }
  }
}
