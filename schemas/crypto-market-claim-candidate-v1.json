{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://8ft0-ai.github.io/crypto-pulse/schemas/crypto-market-claim-candidate-v1.json",
  "title": "CryptoPulse deterministic claim candidate v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "candidate_version",
    "candidate_id",
    "evidence_bundle_id",
    "intent",
    "evidence_ids",
    "comparison_relation",
    "section",
    "subject",
    "metric",
    "confidence",
    "features"
  ],
  "properties": {
    "candidate_version": {
      "const": "crypto-market-claim-candidate/v1"
    },
    "candidate_id": {
      "type": "string",
      "pattern": "^claim-candidate:sha256:[0-9a-f]{64}$"
    },
    "evidence_bundle_id": {
      "type": "string",
      "pattern": "^sha256:[0-9a-f]{64}$"
    },
    "intent": {
      "enum": [
        "absolute_observation",
        "directional_observation",
        "comparison",
        "source_status",
        "data_quality_limitation",
        "snapshot_status"
      ]
    },
    "evidence_ids": {
      "type": "array",
      "minItems": 1,
      "maxItems": 4,
      "uniqueItems": true,
      "items": {
        "type": "string",
        "pattern": "^[a-z][a-z0-9]*(?:[._-][a-z0-9]+)+$"
      }
    },
    "comparison_relation": {
      "enum": [
        "none",
        "greater_than",
        "less_than",
        "approximately_equal",
        "not_equal",
        "opposite_direction"
      ]
    },
    "section": {
      "enum": [
        "market_summary",
        "key_observations",
        "risks_and_limitations",
        "data_quality",
        "source_status"
      ]
    },
    "subject": {
      "$ref": "#/$defs/subject"
    },
    "metric": {
      "type": "string",
      "pattern": "^[a-z][a-z0-9_]*$"
    },
    "confidence": {
      "enum": [
        "high",
        "medium",
        "low"
      ]
    },
    "features": {
      "$ref": "#/$defs/features"
    }
  },
  "allOf": [
    {
      "if": {
        "properties": {
          "intent": {
            "const": "comparison"
          }
        },
        "required": [
          "intent"
        ]
      },
      "then": {
        "properties": {
          "evidence_ids": {
            "minItems": 2,
            "maxItems": 2
          },
          "comparison_relation": {
            "enum": [
              "greater_than",
              "less_than",
              "approximately_equal",
              "not_equal",
              "opposite_direction"
            ]
          }
        }
      },
      "else": {
        "properties": {
          "comparison_relation": {
            "const": "none"
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "intent": {
            "const": "source_status"
          }
        },
        "required": [
          "intent"
        ]
      },
      "then": {
        "properties": {
          "section": {
            "const": "source_status"
          },
          "subject": {
            "properties": {
              "type": {
                "const": "source"
              }
            }
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "intent": {
            "const": "data_quality_limitation"
          }
        },
        "required": [
          "intent"
        ]
      },
      "then": {
        "properties": {
          "section": {
            "enum": [
              "risks_and_limitations",
              "data_quality"
            ]
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "intent": {
            "const": "snapshot_status"
          }
        },
        "required": [
          "intent"
        ]
      },
      "then": {
        "properties": {
          "subject": {
            "properties": {
              "type": {
                "const": "snapshot"
              }
            }
          }
        }
      }
    }
  ],
  "$defs": {
    "subject": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "type",
        "id"
      ],
      "properties": {
        "type": {
          "enum": [
            "asset",
            "market",
            "snapshot",
            "source",
            "exchange_pair",
            "defi_metric"
          ]
        },
        "id": {
          "type": "string",
          "pattern": "^[a-z][a-z0-9]*(?:[._-][a-z0-9]+)*$"
        }
      }
    },
    "features": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "materiality_bucket": {
          "enum": [
            "not_applicable",
            "low",
            "medium",
            "high"
          ]
        },
        "cross_source": {
          "type": "boolean"
        },
        "conflict_status": {
          "enum": [
            "none",
            "corroborated",
            "divergent"
          ]
        },
        "recency_bucket": {
          "enum": [
            "current",
            "recent",
            "stale",
            "unknown"
          ]
        },
        "quality_significance": {
          "enum": [
            "not_applicable",
            "minor",
            "material"
          ]
        },
        "section_eligibility": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {
            "enum": [
              "market_summary",
              "key_observations",
              "risks_and_limitations",
              "data_quality",
              "source_status"
            ]
          }
        },
        "redundancy_group": {
          "type": "string",
          "pattern": "^[a-z][a-z0-9]*(?:[._-][a-z0-9]+)*$"
        },
        "corroboration_count": {
          "type": "integer",
          "minimum": 0
        }
      }
    }
  }
}
